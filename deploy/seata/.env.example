# Copy to deploy/seata/.env only when enabling Seata. Never commit the private .env.
# Console login password; replace before starting Seata.
SEATA_CONSOLE_PASSWORD=replace-with-a-unique-console-password
# Base64-encoded random signing material, at least 32 bytes before encoding.
SEATA_SECRET_KEY=replace-with-a-random-base64-signing-key
